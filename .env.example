# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Application Secret Key
SECRET_KEY=super-secret-production-key-change-this

# Flask Environment and Server Port
FLASK_ENV=development
PORT=5000

# Gemini Model Selection (e.g., gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
